# Fake values only. BE-12-T01 copies this to .env, and exports it into a shell, to prove the suite ignores both.
NODE_ENV=production
TZ=America/New_York
PORT=1
MONGODB_URI=mongodb://hostile.invalid:27017/hostile
JWT_SECRET=hostile-fixture-jwt-secret-not-a-secret-000000
JWT_REFRESH_SECRET=hostile-fixture-refresh-secret-not-a-secret-00
TOKEN_ENCRYPTION_KEY=hostile-fixture-encryption-key-not-a-key-0000
CLIENT_URL=https://portal.hostile.invalid
API_PUBLIC_URL=https://api.hostile.invalid
ANTHROPIC_API_KEY=hostile-fixture-not-a-key
ESKOMSEPUSH_API_KEY=hostile-fixture-not-a-key
WEATHER_API_KEY=hostile-fixture-not-a-key
WEATHER_API_URL=https://weather.hostile.invalid/v1
RESEND_API_KEY=hostile-fixture-not-a-key
RESEND_FROM_EMAIL="Hostile <noreply@hostile.invalid>"
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=hostile-fixture-not-a-key
PAYSTACK_API_URL=https://paystack.hostile.invalid
ONEGATE_API_URL=https://onegate.hostile.invalid
ONEGATE_ORGANISATION_ID=1
ONEGATE_API_SALT=hostile
R2_ACCOUNT_ID=hostile
R2_ACCESS_KEY_ID=hostile
R2_SECRET_ACCESS_KEY=hostile
R2_BUCKET_NAME=hostile
YOCO_INTEGRATION_ENABLED=true
WORKFORCE_ENABLED=false
BILLING_MOCK_ENABLED=false
REQUEST_LOGS_ENABLED=true
API_CACHE_ENABLED=true
RATE_LIMITS_ENABLED=true
BACKGROUND_JOBS_INLINE=false
ORIGIN_CHECKS_ENABLED=true
TRUST_PROXY_HOPS=not-a-number
EMAIL_CONSOLE_LINKS=true
BCRYPT_ROUNDS=15
READINESS_TOKEN=hostile-fixture-readiness-token-not-a-token
UPLOAD_MAX_BYTES=10
UPLOAD_MAX_ROWS=1
AI_USER_DAILY_CREDIT_LIMIT=0
