PORT=5000
MONGODB_URI=mongodb://localhost:27017/your-guava
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ANTHROPIC_API_KEY=your_anthropic_api_key_here
WEATHER_API_KEY=your_weatherapi_key_here
WEATHER_API_URL=https://api.weatherapi.com/v1
# Legacy Yoco OAuth/webhook integration is disabled for MVP. Production startup
# refuses YOCO_INTEGRATION_ENABLED=true; CSV upload presets still work.
YOCO_INTEGRATION_ENABLED=false
# YOCO_CLIENT_ID=
# YOCO_CLIENT_SECRET=
# YOCO_REDIRECT_URI=http://localhost:5173/connect
# YOCO_API_URL=https://api.yoco.com
# YOCO_IAM_URL=https://iam.yoco.com
# YOCO_WEBHOOK_SECRET=
ESKOMSEPUSH_API_KEY=your_eskomsepush_api_key_here
# 32-byte key (64 hex chars or base64) for encrypting stored OAuth tokens.
# Falls back to a key derived from JWT_SECRET when unset.
TOKEN_ENCRYPTION_KEY=
CLIENT_URL=http://localhost:5173
NODE_ENV=development
REQUEST_LOGS_ENABLED=true

# Billing. Development uses mock checkout unless PAYMENT_PROVIDER=onegate.
# Production must use OneGate; mock billing is refused when NODE_ENV=production.
BILLING_MOCK_ENABLED=false
PAYMENT_PROVIDER=
ONEGATE_API_URL=https://payments.onegate.co.za
ONEGATE_ORGANISATION_ID=
ONEGATE_API_SALT=
API_PUBLIC_URL=

# Transactional email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Your Guava <hello@yourdomain.com>"
RESEND_REPLY_TO=

# Cloudflare R2 (file storage for upload history)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=your-guava-uploads
UPLOAD_MAX_BYTES=10485760

# Optional local-only seed helpers. src/seed.js accepts CSV/XLSX imports;
# src/seed-bulk.js is XLSX-only. Seed scripts refuse production and non-local
# databases unless SEED_FORCE=true is explicitly set.
# SEED_IMPORT_FILE=./tests/fixtures/test-transactions.csv
# SEED_USER_NAME=Demo Owner
# SEED_USER_EMAIL=demo@yourguava.local
# SEED_USER_PASSWORD=password123
# SEED_ORG_NAME=Demo Coffee Group
# SEED_CAFE_NAME=Demo Cafe
# SEED_CAFE_CITY=Cape Town
# SEED_CAFE_ADDRESS=Demo address

# Accounting integrations stay disabled for MVP. Production startup refuses true
# until provider posting is implemented end-to-end.
ACCOUNTING_INTEGRATIONS_ENABLED=false

# Xero: https://developer.xero.com/myapps
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:5173/integrations/xero/callback

# QuickBooks (Intuit Developer): https://developer.intuit.com/app/developer/myapps
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:5173/integrations/quickbooks/callback
QUICKBOOKS_ENV=sandbox

# Sage Accounting: https://developer.sage.com/accounting/
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
SAGE_REDIRECT_URI=http://localhost:5173/integrations/sage/callback
